# Database Configuration
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=invoice_db

# Backend Configuration (Internal & External)
BACKEND_URL=http://localhost:4000
PUBLIC_BACKEND_URL=https://api.votre-domaine.com # For Frontend build
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
WHATSAPP_TOKEN=your-meta-whatsapp-token
